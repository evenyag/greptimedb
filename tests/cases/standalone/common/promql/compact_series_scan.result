-- SQLNESS SORT_RESULT 3 1
TQL EVAL (2, 2, '1s') compact_scan_metric{job=~"api|db"};

+----------------+------+-----+---------------------+
| greptime_value | host | job | ts                  |
+----------------+------+-----+---------------------+
| 20.0           | b    | db  | 1970-01-01T00:00:02 |
| 3.0            | a    | api | 1970-01-01T00:00:02 |
+----------------+------+-----+---------------------+

TQL EVAL (2, 2, '1s') sum_over_time(compact_scan_metric{host="a"}[3s]);

+---------------------+---------------------------------------------+------+-----+
| ts                  | prom_sum_over_time(ts_range,greptime_value) | host | job |
+---------------------+---------------------------------------------+------+-----+
| 1970-01-01T00:00:02 | 6.0                                         | a    | api |
+---------------------+---------------------------------------------+------+-----+

TQL EVAL (2, 2, '1s') compact_scan_metric{host!="b"} > 2;

